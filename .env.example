# Public site URL — used for canonical links, Open Graph and the sitemap.
# On Vercel Production set this to your real domain, e.g. https://andrianocherini.com
NEXT_PUBLIC_SITE_URL=https://andrianocherini.com

# Optional: paste codes from Google Search Console and Yandex Webmaster
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
